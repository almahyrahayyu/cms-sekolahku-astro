---
// src/pages/mutasi-masuk.astro
import ServiceLayout from '../layouts/ServiceLayout.astro';
import settings from '../../data/settings.yml';
const wa = settings.wa_admin;
---
<ServiceLayout
  title="Mutasi Masuk"
  badge="Pendaftaran Siswa Pindahan"
  subtitle="Formulir pendaftaran bagi siswa pindahan dari sekolah lain yang ingin bergabung di SDN 3 Ngraji."
  icon="sign-in-alt"
>
  <div class="bg-white rounded-card p-6 shadow-card">
    <form name="mutasi-masuk" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="mutasi-masuk" />
      <label class="block text-sm font-extrabold text-primary-dark mb-1">Nama Siswa *</label>
      <input name="nama_siswa" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">NISN</label>
      <input name="nisn" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Asal Sekolah *</label>
      <input name="asal_sekolah" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Kelas Tujuan *</label>
      <select name="kelas" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15">
        <option value="">-- Pilih Kelas --</option>
        <option value="1">Kelas 1</option>
        <option value="2">Kelas 2</option>
        <option value="3">Kelas 3</option>
        <option value="4">Kelas 4</option>
        <option value="5">Kelas 5</option>
        <option value="6">Kelas 6</option>
      </select>

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Nama Orang Tua / Wali *</label>
      <input name="nama_ortu" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">No. HP / WhatsApp *</label>
      <input name="no_hp" type="tel" required placeholder="08xxxxxxxxxx" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-4 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <button type="submit" class="w-full bg-primary text-white px-6 py-3 rounded-full font-extrabold cursor-pointer shadow-[0_4px_12px_rgba(26,58,107,0.4)] hover:bg-primary-dark transition-colors">
        <i class="fas fa-paper-plane mr-2"></i>Kirim Pendaftaran
      </button>
    </form>
  </div>

  <div class="text-center mt-5">
    <a href={`https://wa.me/${wa}?text=${encodeURIComponent('Halo, saya ingin bertanya tentang Mutasi Masuk SDN 3 Ngraji')}`} target="_blank" class="inline-flex items-center gap-2 bg-success text-white px-6 py-2.5 rounded-full font-extrabold no-underline text-sm">
      <i class="fab fa-whatsapp"></i> Konfirmasi via WhatsApp
    </a>
  </div>
</ServiceLayout>
