---
// src/pages/pengaduan.astro
import ServiceLayout from '../layouts/ServiceLayout.astro';
import settings from '../../data/settings.yml';
const wa = settings.wa_admin;
---
<ServiceLayout
  title="Layanan Pengaduan"
  badge="Laporan & Pengaduan"
  subtitle="Sampaikan laporan atau pengaduan. Identitas pelapor dijaga kerahasiaannya oleh pihak sekolah."
  icon="headset"
>
  <div class="bg-[#f8d7da] border border-[#f5c6cb] rounded-card p-4 mb-5 text-sm text-[#721c24]">
    <i class="fas fa-shield-halved mr-1.5"></i> <b>Rahasia terjamin.</b> Mohon sampaikan pengaduan berdasarkan fakta. Pengaduan palsu dapat dikenai sanksi. Laporan <b>bullying</b> dan <b>pungutan liar</b> akan diprioritaskan.
  </div>

  <div class="bg-white rounded-card p-6 shadow-card">
    <form name="pengaduan" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="pengaduan" />
      <label class="block text-sm font-extrabold text-primary-dark mb-1">Nama Pelapor *</label>
      <input name="nama_pelapor" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Kategori *</label>
      <select name="kategori" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15">
        <option value="">-- Pilih Kategori --</option>
        <option value="Bullying">Bullying / Perundungan</option>
        <option value="Pungutan Liar">Pungutan Liar</option>
        <option value="Pelayanan">Pelayanan</option>
        <option value="Fasilitas">Fasilitas</option>
        <option value="Lainnya">Lainnya</option>
      </select>

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Judul Pengaduan *</label>
      <input name="judul" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Uraian Pengaduan *</label>
      <textarea name="uraian" required rows="5" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 resize-y"></textarea>

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Kontak WhatsApp *</label>
      <input name="kontak" type="tel" required placeholder="08xxxxxxxxxx" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-4 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <button type="submit" class="w-full bg-accent text-white px-6 py-3 rounded-full font-extrabold cursor-pointer shadow-[0_4px_12px_rgba(211,47,47,0.4)] hover:bg-[#b71c1c] transition-colors">
        <i class="fas fa-paper-plane mr-2"></i>Kirim Pengaduan
      </button>
    </form>
  </div>

  <div class="text-center mt-5">
    <a href={`https://wa.me/${wa}?text=${encodeURIComponent('Halo, saya ingin menyampaikan pengaduan terkait SDN 3 Ngraji')}`} target="_blank" class="inline-flex items-center gap-2 bg-success text-white px-6 py-2.5 rounded-full font-extrabold no-underline text-sm">
      <i class="fab fa-whatsapp"></i> Pengaduan via WhatsApp
    </a>
  </div>
</ServiceLayout>
