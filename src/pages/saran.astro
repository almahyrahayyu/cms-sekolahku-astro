---
// src/pages/saran.astro
import ServiceLayout from '../layouts/ServiceLayout.astro';
---
<ServiceLayout
  title="Kotak Saran"
  badge="Aspirasi Anda"
  subtitle="Sampaikan saran dan masukan untuk kemajuan SDN 3 Ngraji. Boleh anonim."
  icon="comments"
>
  <div class="bg-white rounded-card p-6 shadow-card">
    <form name="saran" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="saran" />
      <label class="block text-sm font-extrabold text-primary-dark mb-1">Nama <span class="text-text-muted font-normal">(opsional / boleh kosong)</span></label>
      <input name="nama" placeholder="Anonim" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Kategori *</label>
      <select name="kategori" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15">
        <option value="">-- Pilih Kategori --</option>
        <option value="Fasilitas">Fasilitas</option>
        <option value="Pembelajaran">Pembelajaran</option>
        <option value="Pelayanan">Pelayanan</option>
        <option value="Lainnya">Lainnya</option>
      </select>

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Saran / Masukan *</label>
      <textarea name="pesan" required rows="5" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 resize-y"></textarea>

      <label class="block text-sm font-extrabold text-primary-dark mb-1">Kontak WhatsApp <span class="text-text-muted font-normal">(opsional)</span></label>
      <input name="kontak" type="tel" placeholder="08xxxxxxxxxx" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-4 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />

      <button type="submit" class="w-full bg-primary text-white px-6 py-3 rounded-full font-extrabold cursor-pointer shadow-[0_4px_12px_rgba(26,58,107,0.4)] hover:bg-primary-dark transition-colors">
        <i class="fas fa-paper-plane mr-2"></i>Kirim Saran
      </button>
    </form>
  </div>
</ServiceLayout>
