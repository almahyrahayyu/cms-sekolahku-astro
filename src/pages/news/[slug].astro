---
// src/pages/news/[slug].astro
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Navbar from '../../components/Navbar.astro';
import MobileDrawer from '../../components/MobileDrawer.astro';
import Footer from '../../components/Footer.astro';
import settings from '../../../data/settings.yml';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — ${settings.site_name}`} description={post.data.excerpt}>
  <TopBar />
  <Header />
  <Navbar />
  <MobileDrawer />

  <main class="flex-1">
    <div class="bg-gradient-to-r from-primary to-primary-dark px-6 py-10 text-center text-white">
      <span class="inline-block bg-white/20 text-xs font-bold px-3 py-1 rounded-full mb-2">{post.data.category}</span>
      <h1 class="text-3xl font-extrabold max-w-3xl mx-auto">{post.data.title}</h1>
    </div>

    <article class="max-w-3xl mx-auto px-5 py-9">
      <div class="flex items-center gap-4 text-sm text-text-muted font-bold mb-6 pb-4 border-b border-primary-light">
        <span><i class="fas fa-user mr-1.5 text-primary"></i>{post.data.author}</span>
        <span><i class="fas fa-calendar mr-1.5 text-primary"></i>{new Date(post.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>

      <div class="prose max-w-none text-[0.98rem] leading-relaxed">
        <Content />
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mt-8 pt-4 border-t border-primary-light">
          {post.data.tags.map((tag: string) => (
            <span class="bg-primary-light text-primary-dark text-xs font-bold px-3 py-1 rounded-full">#{tag}</span>
          ))}
        </div>
      )}

      <div class="mt-8 bg-white rounded-card p-6 shadow-card">
        <h3 class="font-extrabold text-primary-dark mb-4"><i class="fas fa-comments mr-2 text-primary"></i>Komentar</h3>
        <p class="text-sm text-text-muted">Komentar menggunakan Giscus (GitHub Discussions). Aktifkan setelah repo GitHub dibuat.</p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
