---
// src/components/ContactSection.astro
import settings from '../../data/settings.yml';
import SectionTitle from './SectionTitle.astro';
---
<section class="max-w-[1100px] mx-auto px-5 py-9">
  <SectionTitle title="Kontak Kami" />
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white rounded-card p-6 shadow-card">
      <h3 class="font-extrabold text-primary-dark mb-4">Kirim Pesan</h3>
      <form name="kontak" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="kontak" />
        <label class="block text-sm font-extrabold text-primary-dark mb-1">Nama</label>
        <input name="nama" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />
        <label class="block text-sm font-extrabold text-primary-dark mb-1">Email</label>
        <input name="email" type="email" required class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15" />
        <label class="block text-sm font-extrabold text-primary-dark mb-1">Pesan</label>
        <textarea name="pesan" required rows="4" class="w-full px-3 py-2.5 border border-[#d0d9e8] rounded-lg text-sm mb-3 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/15 resize-y"></textarea>
        <button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-full font-extrabold cursor-pointer shadow-[0_4px_12px_rgba(26,58,107,0.4)] hover:bg-primary-dark transition-colors">
          <i class="fas fa-paper-plane mr-2"></i>Kirim
        </button>
      </form>
    </div>
    <div class="space-y-4">
      <div class="bg-white rounded-card p-6 shadow-card">
        <h3 class="font-extrabold text-primary-dark mb-4">Informasi Kontak</h3>
        <p class="text-sm mb-3 flex items-start gap-3"><i class="fas fa-map-marker-alt text-primary mt-1"></i><span>{settings.contact_address}</span></p>
        <p class="text-sm mb-3 flex items-center gap-3"><i class="fas fa-phone text-primary"></i><span>{settings.contact_phone}</span></p>
        <p class="text-sm mb-3 flex items-center gap-3"><i class="fas fa-envelope text-primary"></i><span>{settings.contact_email}</span></p>
        <p class="text-sm flex items-center gap-3"><i class="fas fa-clock text-primary"></i><span>{settings.contact_hours}</span></p>
      </div>
      <div class="bg-white rounded-card p-3 shadow-card">
        <div class="w-full h-[200px] bg-primary-light rounded-xl flex flex-col items-center justify-center text-primary-dark">
          <i class="fas fa-map-marked-alt text-4xl mb-2"></i>
          <span class="text-sm font-bold">Peta Lokasi</span>
          <span class="text-xs text-text-muted">{settings.contact_address_short}</span>
        </div>
      </div>
    </div>
  </div>
</section>
