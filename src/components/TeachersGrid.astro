---
// src/components/TeachersGrid.astro
import teachers from '../../data/teachers.yml';
import SectionTitle from './SectionTitle.astro';
const items = teachers.teachers.filter((t: any) => t.show);
---
<section class="max-w-[1100px] mx-auto px-5 py-9">
  <SectionTitle title="Tenaga Pengajar" />
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    {items.map((t: any) => (
      <div class="bg-white rounded-card p-4 shadow-card border border-primary/10 hover:-translate-y-1 transition-transform text-center">
        <div class="w-16 h-16 rounded-full bg-primary-light mx-auto mb-3 flex items-center justify-center text-2xl text-primary border-2 border-secondary overflow-hidden">
          <img src={t.photo} alt={t.name} class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-user\'></i>'" />
        </div>
        <h4 class="font-extrabold text-primary-dark text-sm leading-tight">{t.name}</h4>
        <p class="text-xs text-text-muted font-bold mt-1">{t.role}</p>
        <p class="text-[0.7rem] text-text-muted mt-0.5">{t.education}</p>
      </div>
    ))}
  </div>
</section>
