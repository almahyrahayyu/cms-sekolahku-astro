---
// src/components/Hero.astro
import settings from '../../data/settings.yml';
const heroImage = settings.hero_image || '';
---
<section class="relative bg-gradient-to-br from-primary-light to-[#d4dff0] px-6 py-11 rounded-b-[30px] overflow-hidden">
  <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1.1fr_1fr] gap-8 items-center relative z-10">
    <div class="text-center md:text-left">
      <span class="inline-flex items-center gap-1.5 bg-white text-primary-dark text-xs font-extrabold px-3.5 py-1.5 rounded-full mb-3.5 shadow-card">
        <i class="fas fa-award text-secondary"></i> {settings.hero_badge}
      </span>
      <h2 class="text-[2.3rem] leading-[1.15] text-primary-dark mb-3 font-extrabold">{settings.hero_title}</h2>
      <p class="text-[1.05rem] mb-5 leading-relaxed">{settings.hero_subtitle}</p>
      <div class="flex gap-3 flex-wrap justify-center md:justify-start">
        <a href={settings.hero_btn_primary_url} class="bg-primary text-white px-6 py-3 rounded-full font-extrabold no-underline shadow-[0_4px_12px_rgba(26,58,107,0.4)] hover:bg-primary-dark hover:-translate-y-0.5 transition-all inline-flex items-center gap-2">
          <i class="fas fa-school"></i> {settings.hero_btn_primary_text}
        </a>
        <a href={settings.hero_btn_secondary_url} class="bg-transparent text-primary-dark border-2 border-primary px-6 py-3 rounded-full font-extrabold no-underline hover:bg-primary hover:text-white transition-colors inline-flex items-center gap-2">
          <i class="fas fa-phone"></i> {settings.hero_btn_secondary_text}
        </a>
      </div>
    </div>
    <div class="bg-white p-3 rounded-[20px] shadow-card border-4 border-white rotate-2 hidden md:block">
      {heroImage ? (
        <img src={heroImage} alt={settings.site_name} class="w-full h-[260px] object-cover rounded-xl" />
      ) : (
        <div class="w-full h-[260px] bg-gradient-to-br from-secondary to-primary rounded-xl flex flex-col items-center justify-center text-white text-center p-4">
          <i class="fas fa-school text-5xl mb-3"></i>
          <span class="font-display font-bold text-xl">{settings.site_name}</span>
        </div>
      )}
    </div>
  </div>
</section>
