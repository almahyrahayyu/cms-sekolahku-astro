---
// src/components/Principal.astro
import settings from '../../data/settings.yml';
import SectionTitle from './SectionTitle.astro';
const p = settings.principal;
---
<section class="max-w-[1100px] mx-auto px-5 py-9">
  <SectionTitle title="Sambutan Kepala Sekolah" />
  <div class="bg-white rounded-card p-6 shadow-card border-2 border-dashed border-secondary max-w-2xl mx-auto text-center">
    <div class="w-[90px] h-[90px] rounded-full bg-primary-light mx-auto mb-3 flex items-center justify-center text-4xl text-primary border-[3px] border-secondary overflow-hidden">
      <img src={p.photo} alt={p.name} class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-user-tie\'></i>'" />
    </div>
    <h3 class="text-lg text-primary-dark font-extrabold">{p.name}</h3>
    <p class="text-xs text-text-muted mb-3 font-bold">{p.role_title} · {p.education} · {p.years_of_service}</p>
    <p class="text-sm leading-relaxed italic">"{p.welcome_message}"</p>
  </div>
</section>
