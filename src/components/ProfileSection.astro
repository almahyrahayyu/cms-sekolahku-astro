---
// src/components/ProfileSection.astro
import settings from '../../data/settings.yml';
import SectionTitle from './SectionTitle.astro';
const a = settings.about;
---
<section class="max-w-[1100px] mx-auto px-5 py-9">
  <SectionTitle title="Profil Sekolah" />
  <div class="grid md:grid-cols-2 gap-6 items-center">
    <div class="bg-white rounded-card p-3 shadow-card">
      <div class="w-full h-[280px] bg-gradient-to-br from-primary-light to-primary/20 rounded-xl flex flex-col items-center justify-center text-primary">
        <i class="fas fa-school text-6xl mb-3"></i>
        <span class="font-bold">{settings.site_name}</span>
      </div>
    </div>
    <div>
      <h3 class="text-xl font-extrabold text-primary-dark mb-3">{a.content_title}</h3>
      <p class="text-[0.95rem] leading-relaxed mb-3">{a.content_1}</p>
      <p class="text-[0.95rem] leading-relaxed mb-4">{a.content_2}</p>
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-block bg-secondary text-primary-dark font-extrabold px-3 py-0.5 rounded-xl text-sm">Akreditasi {a.accreditation}</span>
        <span class="text-sm text-text-muted font-bold">{a.accreditation_label}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        {a.highlights.map((h: string) => (
          <span class="bg-primary-light text-primary-dark text-sm font-bold px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5">
            <i class="fas fa-check-circle text-success"></i> {h}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
