---
// src/components/Header.astro
import settings from '../../data/settings.yml';
---
<header class="bg-white px-6 py-4 flex justify-between items-center shadow-[0_4px_12px_rgba(0,0,0,0.03)]">
  <a href="/" class="flex items-center gap-3 no-underline">
    <div class="w-[52px] h-[52px] bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white text-2xl shrink-0 overflow-hidden shadow-[0_4px_10px_rgba(26,58,107,0.3)]">
      <img src="/images/logo.jpg" alt="Logo" class="w-full h-full object-cover rounded-full"
           onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-school\'></i>'" />
    </div>
    <div>
      <h1 class="text-[1.35rem] text-primary-dark font-extrabold leading-tight">{settings.site_name}</h1>
      <p class="text-xs text-text-muted font-bold">Kec. Purwodadi &bull; Kab. Grobogan &bull; Terakreditasi {settings.about.accreditation}</p>
    </div>
  </a>
</header>
