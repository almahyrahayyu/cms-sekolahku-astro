---
// src/components/FaqAccordion.astro
import faq from '../../data/faq.yml';
import SectionTitle from './SectionTitle.astro';
const items = faq.faq.filter((f: any) => f.show);
---
<section class="max-w-[1100px] mx-auto px-5 py-9">
  <SectionTitle title="Pertanyaan Umum (FAQ)" />
  <div class="max-w-3xl mx-auto space-y-3">
    {items.map((f: any, i: number) => (
      <details class="bg-white rounded-card shadow-card border border-primary/10 group">
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-extrabold text-primary-dark list-none">
          <span class="flex items-center gap-3">
            <i class="fas fa-circle-question text-primary"></i> {f.question}
          </span>
          <i class="fas fa-chevron-down text-text-muted transition-transform group-open:rotate-180"></i>
        </summary>
        <div class="px-5 pb-4 text-sm text-text-muted leading-relaxed border-t border-primary-light pt-3">
          {f.answer}
        </div>
      </details>
    ))}
  </div>
</section>
